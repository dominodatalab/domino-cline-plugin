# Template for ~/.domino/.env — Domino credentials for domino_mcp_server and
# scripts/domino-tsh, used when Cline is running on your laptop rather than
# inside a Domino workspace/job/app.
#
# Copy this file to ~/.domino/.env and fill in real values:
#   cp domino.env.example ~/.domino/.env
#
# ~/.domino/.env is outside this repo and gitignored wherever it lives —
# never commit your filled-in copy.

# ─── Option A: a single Domino instance ────────────────────────────────────
# Uncomment and fill in if you only ever talk to one Domino cluster.

# DOMINO_HOST=https://your-instance.cs.domino.tech
# DOMINO_API_KEY=your-api-key-here

# ─── Option B: multiple Domino instances ───────────────────────────────────
# Uncomment and fill in if you work against more than one cluster. Pick your
# own short alias per cluster (lowercase letters/digits, no spaces) and
# repeat the two lines below for each one. Every domino_server MCP tool then
# takes an optional `cluster` argument matching one of these aliases; call
# the `list_domino_clusters` tool to see what's configured.

# DOMINO_CLUSTERS=dev,prod
# DOMINO_HOST_DEV=https://dev.cs.domino.tech
# DOMINO_API_KEY_DEV=your-dev-api-key
# DOMINO_HOST_PROD=https://prod.cs.domino.tech
# DOMINO_API_KEY_PROD=your-prod-api-key

# Optional: which alias to use when a tool call doesn't specify `cluster`.
# Defaults to the first alias in DOMINO_CLUSTERS if omitted.
# DOMINO_DEFAULT_CLUSTER=dev

# ─── Teleport (scripts/domino-tsh, domino-teleport skill) ──────────────────
# Per-cluster Teleport proxy, keyed by the same aliases as DOMINO_CLUSTERS
# above (or a single TELEPORT_PROXY_DEFAULT if you're using Option A).

# TELEPORT_PROXY_DEV=dev-teleport.domino.tech:443
# TELEPORT_CLUSTER_NAME_DEV=dev  # optional, defaults to the alias
# TELEPORT_PROXY_PROD=prod-teleport.domino.tech:443
# TELEPORT_CLUSTER_NAME_PROD=prod
